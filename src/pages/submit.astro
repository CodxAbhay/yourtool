---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Submit Resource | yourtool.in">
  <div class="mx-auto max-w-5xl px-4 py-24 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto">
      <h1 class="text-4xl font-extrabold tracking-tight text-black dark:text-white sm:text-6xl">
        Share with the <span class="text-blue-600">Community.</span>
      </h1>
      <p class="mt-6 text-xl text-gray-600 dark:text-zinc-400">
        Choose what you'd like to add to our curated directory. Your contribution helps builders discover the best resources.
      </p>
    </div>

    <div class="mt-20 grid grid-cols-1 gap-8 sm:grid-cols-2">
      <!-- Submit Tool -->
      <a href="/submit/tool" class="group relative flex flex-col items-center text-center p-12 rounded-[2.5rem] bg-white dark:bg-zinc-900 border border-gray-100 dark:border-zinc-800 shadow-xl hover:shadow-2xl transition-all hover:-translate-y-2 overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-br from-blue-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
        
        <div class="relative h-24 w-24 rounded-3xl bg-blue-50 dark:bg-blue-900/30 flex items-center justify-center text-blue-600 dark:text-blue-400 mb-8 group-hover:scale-110 transition-transform duration-500">
          <svg class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z" />
          </svg>
        </div>
        
        <h2 class="relative text-3xl font-bold text-black dark:text-white">Submit a Tool</h2>
        <p class="relative mt-4 text-gray-500 dark:text-zinc-400 leading-relaxed">
          SaaS, libraries, desktop apps, or AI tools. Anything that solves a problem for developers and builders.
        </p>
        
        <div class="relative mt-8 inline-flex items-center gap-2 font-bold text-blue-600 uppercase tracking-widest text-xs">
          Get Started
          <svg class="h-4 w-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </div>
      </a>

      <!-- Submit Website -->
      <a href="/submit/website" class="group relative flex flex-col items-center text-center p-12 rounded-[2.5rem] bg-white dark:bg-zinc-900 border border-gray-100 dark:border-zinc-800 shadow-xl hover:shadow-2xl transition-all hover:-translate-y-2 overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-br from-zinc-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>

        <div class="relative h-24 w-24 rounded-3xl bg-zinc-50 dark:bg-zinc-800 flex items-center justify-center text-zinc-600 dark:text-zinc-400 mb-8 group-hover:scale-110 transition-transform duration-500">
          <svg class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
          </svg>
        </div>

        <h2 class="relative text-3xl font-bold text-black dark:text-white">Submit a Website</h2>
        <p class="relative mt-4 text-gray-500 dark:text-zinc-400 leading-relaxed">
          Articles, blogs, inspiration galleries, or niche resources. Help others find the best content on the web.
        </p>

        <div class="relative mt-8 inline-flex items-center gap-2 font-bold text-zinc-600 dark:text-zinc-400 uppercase tracking-widest text-xs">
          Get Started
          <svg class="h-4 w-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </div>
      </a>
    </div>

    <div class="mt-24 text-center">
      <p class="text-sm text-gray-500 dark:text-zinc-500">
        Already have resources? <a href="/my-tools" class="font-bold text-black dark:text-white hover:underline underline-offset-4">Go to your Workspace</a>
      </p>
    </div>
  </div>
</Layout>
