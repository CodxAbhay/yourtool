---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';

// Fetch categories from Supabase
const { data: categories } = await supabase
  .from('categories')
  .select('name')
  .is('user_id', null) // Only global categories
  .order('name');

const defaultCategories = ['AI Tools', 'Design', 'Development', 'Marketing', 'Productivity', '📂 Miscellaneous'];
const fetchedCategories = categories && categories.length > 0 
  ? categories.map(c => c.name) 
  : defaultCategories;

// Ensure Miscellaneous is at the end if it exists
const displayCategories = fetchedCategories.filter(c => !c.includes('Miscellaneous'));
if (fetchedCategories.some(c => c.includes('Miscellaneous'))) {
  displayCategories.push(fetchedCategories.find(c => c.includes('Miscellaneous'))!);
} else if (!displayCategories.includes('📂 Miscellaneous')) {
  displayCategories.push('📂 Miscellaneous');
}
---

<Layout title="Submit a Tool | yourtool.in">
  <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="text-center">
      <h1 class="text-3xl font-bold tracking-tight text-black dark:text-white sm:text-4xl">Submit a Tool</h1>
      <p class="mt-4 text-lg text-gray-600 dark:text-zinc-400">
        Found a hidden gem? Share it with the community. We'll review and add it to the directory.
      </p>
    </div>

    <form id="submission-form" class="mt-12 space-y-6 rounded-2xl border border-gray-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-8 shadow-sm">
      <input type="hidden" name="favicon_url" id="favicon_url" />
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <div class="sm:col-span-2">
          <label for="url" class="block text-sm font-medium text-gray-700 dark:text-zinc-300">Website URL</label>
          <div class="mt-1 flex gap-2">
            <input type="url" name="url" id="url" required placeholder="https://..." class="block w-full rounded-md border-gray-200 dark:border-zinc-800 bg-white dark:bg-zinc-800 text-sm focus:border-black dark:focus:border-white focus:ring-black dark:focus:ring-white px-4 py-2 border dark:border-zinc-700" />
            <button type="button" id="fetch-meta-btn" class="rounded-md bg-gray-100 dark:bg-zinc-800 px-4 py-2 text-xs font-bold hover:bg-gray-200 dark:hover:bg-zinc-700 transition-colors">Fetch Meta</button>
          </div>
        </div>
        <div>
          <label for="title" class="block text-sm font-medium text-gray-700 dark:text-zinc-300">Tool Name</label>
          <input type="text" name="title" id="title" required placeholder="e.g. Astro" class="mt-1 block w-full rounded-md border-gray-200 dark:border-zinc-800 bg-white dark:bg-zinc-800 text-sm focus:border-black dark:focus:border-white focus:ring-black dark:focus:ring-white px-4 py-2 border dark:border-zinc-700" />
        </div>
        <div>
          <label for="category" class="block text-sm font-medium text-gray-700 dark:text-zinc-300">Category</label>
          <select name="category" id="category" class="mt-1 block w-full rounded-md border-gray-200 dark:border-zinc-800 bg-white dark:bg-zinc-800 text-sm focus:border-black dark:focus:border-white focus:ring-black dark:focus:ring-white px-4 py-2 border dark:border-zinc-700">
            {displayCategories.map(cat => (
              <option value={cat}>{cat}</option>
            ))}
          </select>
        </div>
        <div class="sm:col-span-2">
          <label for="description" class="block text-sm font-medium text-gray-700 dark:text-zinc-300">Description</label>
          <textarea name="description" id="description" rows="3" class="mt-1 block w-full rounded-md border-gray-200 dark:border-zinc-800 bg-white dark:bg-zinc-800 text-sm focus:border-black dark:focus:border-white focus:ring-black dark:focus:ring-white px-4 py-2 border dark:border-zinc-700" placeholder="What makes this tool a hidden gem?"></textarea>
        </div>
      </div>

      <div class="flex items-center justify-end gap-4 border-t border-gray-100 dark:border-zinc-800 pt-6">
        <button type="submit" id="submit-btn" class="rounded-md bg-black dark:bg-white px-6 py-2 text-sm font-semibold text-white dark:text-black shadow-sm hover:bg-gray-800 dark:hover:bg-zinc-200 transition-colors disabled:opacity-50">
          Submit for Review
        </button>
      </div>
    </form>

    <div id="success-message" class="hidden mt-8 rounded-lg bg-green-50 dark:bg-green-900/30 p-4 text-center text-green-700 dark:text-green-400 border border-green-100 dark:border-green-800">
      Thank you! Your submission has been received and will be reviewed shortly.
    </div>
    
    <div id="error-message" class="hidden mt-8 rounded-lg bg-red-50 dark:bg-red-900/30 p-4 text-center text-red-700 dark:text-red-400 border border-red-100 dark:border-red-800">
      Something went wrong. Please try again.
    </div>
  </div>

  <script>
    import { supabase } from '../lib/supabase';

    const form = document.getElementById('submission-form') as HTMLFormElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const fetchBtn = document.getElementById('fetch-meta-btn') as HTMLButtonElement;
    const success = document.getElementById('success-message');
    const errorMsg = document.getElementById('error-message');

    // Fetch Metadata
    fetchBtn.onclick = async () => {
      const urlInput = document.getElementById('url') as HTMLInputElement;
      const url = urlInput.value;
      if (!url || !url.startsWith('http')) {
        alert('Please enter a valid URL (starting with http:// or https://)');
        return;
      }

      fetchBtn.disabled = true;
      fetchBtn.textContent = 'Fetching...';

      try {
        const response = await fetch('/api/fetch-meta', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ url })
        });
        const meta = await response.json();

        if (meta.title) (document.getElementById('title') as HTMLInputElement).value = meta.title;
        if (meta.description) (document.getElementById('description') as HTMLTextAreaElement).value = meta.description;
        if (meta.favicon_url) (document.getElementById('favicon_url') as HTMLInputElement).value = meta.favicon_url;
      } catch (err) {
        console.error('Meta fetch error:', err);
      } finally {
        fetchBtn.disabled = false;
        fetchBtn.textContent = 'Fetch Meta';
      }
    };

    form.onsubmit = async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      errorMsg?.classList.add('hidden');
      
      const formData = new FormData(form);
      const data = Object.fromEntries(formData);

      try {
        const { data: { user } } = await supabase.auth.getUser();
        
        const { error } = await supabase
          .from('submissions')
          .insert({
            url: data.url,
            title: data.title,
            category: data.category,
            description: data.description,
            favicon_url: data.favicon_url,
            user_id: user?.id || null,
            status: 'pending'
          });

        if (error) throw error;
        
        form.classList.add('hidden');
        success?.classList.remove('hidden');
      } catch (err) {
        console.error('Submission error:', err);
        errorMsg?.classList.remove('hidden');
        submitBtn.disabled = false;
      }
    };
  </script>
</Layout>
