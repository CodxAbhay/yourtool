---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404: Page Not Found | yourtool.in">
	<section class="relative min-h-[70vh] flex items-center justify-center overflow-hidden">
		<!-- Mesh Gradient Background (reused from index) -->
		<div class="absolute top-0 left-1/2 -z-10 h-[1000px] w-[1000px] -translate-x-1/2 [mask-image:radial-gradient(closest-side,white,transparent)]">
			<div class="absolute inset-0 bg-gradient-to-r from-cyan-400 via-blue-500 to-magenta-500 opacity-20 blur-3xl"></div>
		</div>

		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
			<p class="text-sm font-semibold text-blue-600 dark:text-cyan-400 uppercase tracking-wide">404 Error</p>
			<h1 class="mt-4 text-4xl font-extrabold tracking-tight text-black dark:text-white sm:text-6xl">
				Lost in the <br />
				<span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-cyan-500">digital void?</span>
			</h1>
			<p class="mt-6 mx-auto max-w-2xl text-lg text-gray-600 dark:text-zinc-400">
				Sorry, we couldn't find the page you're looking for. It might have been moved, deleted, or never existed in the first place.
			</p>
			<div class="mt-10 flex flex-wrap items-center justify-center gap-4">
				<a href="/" class="rounded-full bg-black dark:bg-white px-8 py-3 text-sm font-semibold text-white dark:text-black shadow-sm hover:bg-gray-800 dark:hover:bg-zinc-200 transition-all transform hover:scale-105">
					Back to Home
				</a>
				<a href="/directory" class="rounded-full bg-white dark:bg-zinc-900 border border-gray-200 dark:border-zinc-800 px-8 py-3 text-sm font-semibold text-gray-900 dark:text-zinc-100 shadow-sm hover:bg-gray-50 dark:hover:bg-zinc-800 transition-all">
					Explore Hidden Gems
				</a>
			</div>
		</div>
	</section>
</Layout>
