---
import Layout from '../layouts/Layout.astro';
---

<Layout title="How To Use | yourtool.in" description="Learn how to use yourtool.in effectively to manage your links and discover new tools.">
    <!-- Hero Section -->
    <section class="relative overflow-hidden pt-16 pb-12 border-b border-gray-100 dark:border-zinc-800">
        <div class="absolute top-0 left-1/2 -z-10 h-[600px] w-[600px] -translate-x-1/2 [mask-image:radial-gradient(closest-side,white,transparent)]">
            <div class="absolute inset-0 bg-gradient-to-r from-blue-500 via-cyan-400 to-magenta-500 opacity-10 blur-3xl"></div>
        </div>
        <div class="max-w-4xl mx-auto px-4 text-center">
            <h1 class="text-4xl font-extrabold tracking-tight text-black dark:text-white sm:text-5xl mb-4">
                Getting Started with <span class="text-blue-600">yourtool.in</span>
            </h1>
            <p class="text-lg text-gray-600 dark:text-zinc-400 max-w-2xl mx-auto">
                Master your workflow in minutes. Here's how to make the most of our platform.
            </p>
        </div>
    </section>

    <div class="max-w-4xl mx-auto px-4 py-16 space-y-20">
        <!-- Step 1 -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
            <div>
                <div class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-black dark:bg-white text-white dark:text-black font-bold mb-6">1</div>
                <h2 class="text-2xl font-bold text-black dark:text-white mb-4">Set Up Your My Tools</h2>
                <p class="text-gray-600 dark:text-zinc-400 leading-relaxed mb-6">
                    Your My Tools is your private command center. Simply paste any URL, and we'll automatically fetch the title, description, and even a preview image for you.
                </p>
                <ul class="space-y-3 text-sm text-gray-600 dark:text-zinc-400">
                    <li class="flex items-center gap-2">
                        <svg class="w-5 h-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                        One-click link saving
                    </li>
                    <li class="flex items-center gap-2">
                        <svg class="w-5 h-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                        Automatic metadata fetching
                    </li>
                    <li class="flex items-center gap-2">
                        <svg class="w-5 h-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                        Easy categorization with tags
                    </li>
                </ul>
            </div>
            <div class="bg-gray-50 dark:bg-zinc-900 rounded-2xl p-8 border border-gray-100 dark:border-zinc-800 shadow-sm">
                <div class="aspect-video bg-white dark:bg-zinc-950 rounded-lg border border-gray-200 dark:border-zinc-800 flex items-center justify-center overflow-hidden">
                    <div class="p-4 w-full">
                        <div class="h-8 bg-gray-100 dark:bg-zinc-800 rounded mb-4 w-3/4 animate-pulse"></div>
                        <div class="h-4 bg-gray-50 dark:bg-zinc-900 rounded mb-2 w-full animate-pulse"></div>
                        <div class="h-4 bg-gray-50 dark:bg-zinc-900 rounded mb-2 w-5/6 animate-pulse"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Step 2 -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
            <div class="order-2 md:order-1 bg-gray-50 dark:bg-zinc-900 rounded-2xl p-8 border border-gray-100 dark:border-zinc-800 shadow-sm">
                 <div class="grid grid-cols-2 gap-4">
                    <div class="aspect-square bg-white dark:bg-zinc-950 rounded-lg border border-gray-200 dark:border-zinc-800 p-3">
                        <div class="w-8 h-8 rounded bg-cyan-100 dark:bg-cyan-900/30 mb-2"></div>
                        <div class="h-2 bg-gray-100 dark:bg-zinc-800 rounded w-full"></div>
                    </div>
                    <div class="aspect-square bg-white dark:bg-zinc-950 rounded-lg border border-gray-200 dark:border-zinc-800 p-3">
                        <div class="w-8 h-8 rounded bg-blue-100 dark:bg-blue-900/30 mb-2"></div>
                        <div class="h-2 bg-gray-100 dark:bg-zinc-800 rounded w-full"></div>
                    </div>
                    <div class="aspect-square bg-white dark:bg-zinc-950 rounded-lg border border-gray-200 dark:border-zinc-800 p-3">
                        <div class="w-8 h-8 rounded bg-magenta-100 dark:bg-magenta-900/30 mb-2"></div>
                        <div class="h-2 bg-gray-100 dark:bg-zinc-800 rounded w-full"></div>
                    </div>
                    <div class="aspect-square bg-white dark:bg-zinc-950 rounded-lg border border-gray-200 dark:border-zinc-800 p-3">
                        <div class="w-8 h-8 rounded bg-amber-100 dark:bg-amber-900/30 mb-2"></div>
                        <div class="h-2 bg-gray-100 dark:bg-zinc-800 rounded w-full"></div>
                    </div>
                 </div>
            </div>
            <div class="order-1 md:order-2">
                <div class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-black dark:bg-white text-white dark:text-black font-bold mb-6">2</div>
                <h2 class="text-2xl font-bold text-black dark:text-white mb-4">Discover Hidden Gems</h2>
                <p class="text-gray-600 dark:text-zinc-400 leading-relaxed mb-6">
                    Explore our curated directory of tools that are vetted by the community. From obscure libraries to game-changing utilities, find what you need to level up.
                </p>
                <div class="flex gap-4">
                    <a href="/directory" class="text-sm font-bold text-blue-600 hover:underline">Explore Directory →</a>
                </div>
            </div>
        </div>

        <!-- Step 3 -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
            <div>
                <div class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-black dark:bg-white text-white dark:text-black font-bold mb-6">3</div>
                <h2 class="text-2xl font-bold text-black dark:text-white mb-4">Join the Community</h2>
                <p class="text-gray-600 dark:text-zinc-400 leading-relaxed mb-6">
                    Found a great tool? Share it with the community by clicking the "Submit a Tool" button. Your contributions help make <span class="font-bold">yourtool.in</span> the best resource for everyone.
                </p>
                <a href="/submit" class="inline-flex items-center justify-center rounded-md bg-black dark:bg-white px-6 py-2 text-sm font-medium text-white dark:text-black hover:bg-gray-800 dark:hover:bg-zinc-200 transition-colors">
                    Submit Your First Tool
                </a>
            </div>
            <div class="bg-gray-50 dark:bg-zinc-900 rounded-2xl p-8 border border-gray-100 dark:border-zinc-800 shadow-sm flex items-center justify-center">
                <div class="text-6xl">🚀</div>
            </div>
        </div>

        <!-- Pro Tip -->
        <div class="bg-blue-600 rounded-3xl p-8 md:p-12 text-white relative overflow-hidden">
            <div class="relative z-10">
                <h2 class="text-3xl font-bold mb-4">Pro Tip: Guest Mode</h2>
                <p class="text-blue-100 text-lg max-w-2xl mb-8">
                    You don't even need an account to start! yourtool.in saves your links locally in your browser. When you're ready to sync across devices, just sign up and your data will follow you.
                </p>
                <a href="/login" class="inline-flex items-center justify-center rounded-full bg-white px-8 py-3 text-sm font-bold text-blue-600 hover:bg-blue-50 transition-colors">
                    Create a Free Account
                </a>
            </div>
            <div class="absolute top-0 right-0 -translate-y-1/2 translate-x-1/4 w-96 h-96 bg-white opacity-10 rounded-full blur-3xl"></div>
        </div>
    </div>
</Layout>
