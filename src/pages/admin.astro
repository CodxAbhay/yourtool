---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Admin Panel | yourtool.in">
  <!-- We wrap everything in a hidden container until we confirm admin status -->
  <div id="admin-content" class="invisible mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between border-b border-gray-200 dark:border-zinc-800 pb-8">
      <div>
        <h1 class="text-3xl font-bold tracking-tight text-black dark:text-white">Admin Dashboard</h1>
        <p class="mt-2 text-gray-600 dark:text-zinc-400">Manage submissions, tools, and categories.</p>
      </div>
      <div class="flex items-center gap-4">
        <span class="inline-flex items-center rounded-md bg-purple-50 dark:bg-purple-900/30 px-2.5 py-1 text-xs font-medium text-purple-700 dark:text-purple-400 ring-1 ring-inset ring-purple-700/10 dark:ring-purple-400/20">Admin Mode</span>
      </div>
    </div>

    <!-- Quick Actions -->
    <div class="mt-12 grid grid-cols-1 gap-8 lg:grid-cols-2">
      <!-- Add New Tool -->
      <div class="rounded-2xl border border-gray-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-8 shadow-sm">
        <h2 class="text-xl font-bold text-black dark:text-white mb-6">Directly Add a Tool</h2>
        <form id="add-tool-form" class="space-y-4">
          <input type="hidden" name="favicon_url" id="admin-favicon-url" />
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div class="sm:col-span-2">
              <label class="block text-xs font-bold uppercase tracking-wider text-gray-500 mb-1">URL</label>
              <div class="flex gap-2">
                <input type="url" name="url" id="admin-url" required class="flex-1 rounded-md border-gray-200 dark:border-zinc-800 bg-gray-50 dark:bg-zinc-800 px-4 py-2 text-sm" placeholder="https://..." />
                <button type="button" id="admin-fetch-btn" class="rounded-md bg-gray-100 dark:bg-zinc-800 px-3 py-2 text-[10px] font-bold hover:bg-gray-200 dark:hover:bg-zinc-700 transition-colors uppercase">Fetch</button>
              </div>
            </div>
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-gray-500 mb-1">Title</label>
              <input type="text" name="title" id="admin-title" required class="block w-full rounded-md border-gray-200 dark:border-zinc-800 bg-gray-50 dark:bg-zinc-800 px-4 py-2 text-sm" placeholder="Tool Name" />
            </div>
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-gray-500 mb-1">Category</label>
              <select id="category-select-admin" name="category_id" required class="block w-full rounded-md border-gray-200 dark:border-zinc-800 bg-gray-50 dark:bg-zinc-800 px-4 py-2 text-sm">
                <option value="">Select Category</option>
              </select>
            </div>
            <div class="sm:col-span-2">
              <label class="block text-xs font-bold uppercase tracking-wider text-gray-500 mb-1">Description</label>
              <textarea name="description" id="admin-description" rows="2" class="block w-full rounded-md border-gray-200 dark:border-zinc-800 bg-gray-50 dark:bg-zinc-800 px-4 py-2 text-sm" placeholder="Short description..."></textarea>
            </div>
          </div>
          <button type="submit" class="w-full rounded-md bg-black dark:bg-white px-4 py-2.5 text-sm font-bold text-white dark:text-black hover:opacity-90 transition-opacity">
            Add to Directory
          </button>
        </form>
      </div>

      <!-- Add New Category -->
      <div class="rounded-2xl border border-gray-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-8 shadow-sm">
        <h2 class="text-xl font-bold text-black dark:text-white mb-6">Manage Categories</h2>
        <form id="add-category-form" class="flex gap-4 mb-8">
          <input type="text" name="name" required class="flex-1 rounded-md border-gray-200 dark:border-zinc-800 bg-gray-50 dark:bg-zinc-800 px-4 py-2 text-sm" placeholder="New category name..." />
          <button type="submit" class="rounded-md bg-blue-600 px-4 py-2 text-sm font-bold text-white hover:bg-blue-700 transition-colors">
            Add
          </button>
        </form>

        <div id="categories-list" class="space-y-2 max-h-[200px] overflow-y-auto pr-2">
          <!-- Categories will be rendered here -->
        </div>
      </div>
    </div>

    <!-- Submissions Table -->
    <div class="mt-12 overflow-hidden rounded-2xl border border-gray-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 shadow-sm">
      <div class="border-b border-gray-100 dark:border-zinc-800 px-6 py-4">
        <h2 class="text-lg font-bold text-black dark:text-white">User Submissions</h2>
      </div>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-zinc-800">
          <thead class="bg-gray-50 dark:bg-zinc-800/50">
            <tr>
              <th class="px-6 py-3 text-left text-[10px] font-bold uppercase tracking-widest text-gray-500">Tool</th>
              <th class="px-6 py-3 text-left text-[10px] font-bold uppercase tracking-widest text-gray-500">Category</th>
              <th class="px-6 py-3 text-left text-[10px] font-bold uppercase tracking-widest text-gray-500">Status</th>
              <th class="px-6 py-3 text-right text-[10px] font-bold uppercase tracking-widest text-gray-500">Actions</th>
            </tr>
          </thead>
          <tbody id="submissions-list" class="divide-y divide-gray-200 dark:divide-zinc-800 bg-white dark:bg-zinc-900">
            <!-- Submissions will be rendered here -->
          </tbody>
        </table>
      </div>
    </div>

    <!-- Contact Messages Table -->
    <div class="mt-12 overflow-hidden rounded-2xl border border-gray-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 shadow-sm">
      <div class="border-b border-gray-100 dark:border-zinc-800 px-6 py-4">
        <h2 class="text-lg font-bold text-black dark:text-white">Contact Messages</h2>
      </div>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-zinc-800">
          <thead class="bg-gray-50 dark:bg-zinc-800/50">
            <tr>
              <th class="px-6 py-3 text-left text-[10px] font-bold uppercase tracking-widest text-gray-500">Sender</th>
              <th class="px-6 py-3 text-left text-[10px] font-bold uppercase tracking-widest text-gray-500">Subject</th>
              <th class="px-6 py-3 text-left text-[10px] font-bold uppercase tracking-widest text-gray-500">Message</th>
              <th class="px-6 py-3 text-right text-[10px] font-bold uppercase tracking-widest text-gray-500">Actions</th>
            </tr>
          </thead>
          <tbody id="contacts-list" class="divide-y divide-gray-200 dark:divide-zinc-800 bg-white dark:bg-zinc-900">
            <!-- Contact messages will be rendered here -->
          </tbody>
        </table>
      </div>
    </div>

    <!-- Directory Management -->
    <div class="mt-12 overflow-hidden rounded-2xl border border-gray-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 shadow-sm">
      <div class="border-b border-gray-100 dark:border-zinc-800 px-6 py-4 flex items-center justify-between">
        <h2 class="text-lg font-bold text-black dark:text-white">Directory Tools</h2>
        <input type="text" id="tool-search" placeholder="Search tools..." class="rounded-md border-gray-200 dark:border-zinc-800 bg-gray-50 dark:bg-zinc-800 px-4 py-1 text-xs" />
      </div>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-zinc-800">
          <thead class="bg-gray-50 dark:bg-zinc-800/50">
            <tr>
              <th class="px-6 py-3 text-left text-[10px] font-bold uppercase tracking-widest text-gray-500">Tool</th>
              <th class="px-6 py-3 text-left text-[10px] font-bold uppercase tracking-widest text-gray-500">Category</th>
              <th class="px-6 py-3 text-left text-[10px] font-bold uppercase tracking-widest text-gray-500">Stats</th>
              <th class="px-6 py-3 text-right text-[10px] font-bold uppercase tracking-widest text-gray-500">Actions</th>
            </tr>
          </thead>
          <tbody id="tools-list" class="divide-y divide-gray-200 dark:divide-zinc-800 bg-white dark:bg-zinc-900">
            <!-- Tools will be rendered here -->
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Edit Tool Modal -->
  <div id="edit-tool-modal" class="hidden fixed inset-0 z-[70] flex items-center justify-center bg-black/50 backdrop-blur-sm p-4">
    <div class="w-full max-w-lg rounded-2xl bg-white dark:bg-zinc-900 p-8 shadow-2xl">
      <h3 class="text-xl font-bold text-black dark:text-white mb-6">Edit Tool</h3>
      <form id="edit-tool-form" class="space-y-4">
        <input type="hidden" name="id" id="edit-id" />
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-gray-500 mb-1">URL</label>
          <input type="url" name="url" id="edit-url" required class="block w-full rounded-md border-gray-200 dark:border-zinc-800 bg-gray-50 dark:bg-zinc-800 px-4 py-2 text-sm" />
        </div>
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-gray-500 mb-1">Title</label>
          <input type="text" name="title" id="edit-title" required class="block w-full rounded-md border-gray-200 dark:border-zinc-800 bg-gray-50 dark:bg-zinc-800 px-4 py-2 text-sm" />
        </div>
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-gray-500 mb-1">Favicon URL</label>
          <input type="text" name="favicon_url" id="edit-favicon" class="block w-full rounded-md border-gray-200 dark:border-zinc-800 bg-gray-50 dark:bg-zinc-800 px-4 py-2 text-sm" />
        </div>
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-gray-500 mb-1">Category</label>
          <select id="edit-category-select" name="category_id" required class="block w-full rounded-md border-gray-200 dark:border-zinc-800 bg-gray-50 dark:bg-zinc-800 px-4 py-2 text-sm"></select>
        </div>
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-gray-500 mb-1">Description</label>
          <textarea name="description" id="edit-description" rows="3" class="block w-full rounded-md border-gray-200 dark:border-zinc-800 bg-gray-50 dark:bg-zinc-800 px-4 py-2 text-sm"></textarea>
        </div>
        <div class="flex justify-end gap-3 mt-8">
          <button type="button" id="close-edit-modal" class="rounded-md bg-gray-100 dark:bg-zinc-800 px-4 py-2 text-sm font-bold">Cancel</button>
          <button type="submit" class="rounded-md bg-black dark:bg-white px-6 py-2 text-sm font-bold text-white dark:text-black">Save Changes</button>
        </div>
      </form>
    </div>
  </div>

  <div id="loading-overlay" class="fixed inset-0 z-[60] flex items-center justify-center bg-white dark:bg-zinc-950">
    <div class="flex flex-col items-center gap-4">
      <div class="h-8 w-8 animate-spin rounded-full border-4 border-black dark:border-white border-t-transparent"></div>
      <p class="text-sm font-medium text-gray-500">Verifying Admin Access...</p>
    </div>
  </div>
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  const content = document.getElementById('admin-content');
  const overlay = document.getElementById('loading-overlay');
  
  let allCategories = [];
  let allTools = [];

  async function checkAdmin() {
    const { data: { user } } = await supabase.auth.getUser();
    
    if (!user) {
      window.location.href = '/login';
      return;
    }

    const { data: profile } = await supabase
      .from('profiles')
      .select('role')
      .eq('id', user.id)
      .single();

    if (profile?.role !== 'admin') {
      window.location.href = '/workspace';
      return;
    }

    overlay?.classList.add('hidden');
    content?.classList.remove('invisible');
    loadAdminData();
  }

  async function loadAdminData() {
    // 1. Fetch Categories
    const { data: rawCategories } = await supabase
      .from('categories')
      .select('*')
      .is('user_id', null)
      .order('name');
    
    // Sort Miscellaneous at the end
    const sortedCats = (rawCategories || []).filter(c => !c.name.includes('Miscellaneous'));
    const miscCat = (rawCategories || []).find(c => c.name.includes('Miscellaneous'));
    if (miscCat) sortedCats.push(miscCat);
    
    allCategories = sortedCats;
      
    const catSelects = [
      document.getElementById('category-select-admin'),
      document.getElementById('edit-category-select')
    ];
    const catList = document.getElementById('categories-list');
    
    catSelects.forEach(sel => {
      if (sel) {
        (sel as HTMLSelectElement).innerHTML = '<option value="">Select Category</option>' + 
          allCategories.map(c => `<option value="${c.id}">${c.name}</option>`).join('');
      }
    });

    if (catList) {
      catList.innerHTML = allCategories.map(c => `
        <div class="flex items-center justify-between rounded-lg bg-gray-50 dark:bg-zinc-800 px-4 py-2">
          <input type="text" class="category-name-input bg-transparent border-none text-sm font-medium text-gray-700 dark:text-zinc-300 focus:ring-0" value="${c.name}" data-id="${c.id}" />
          <div class="flex gap-3">
            <button class="update-category text-[10px] text-blue-500 font-bold uppercase" data-id="${c.id}">Save</button>
            <button class="delete-category text-[10px] text-red-500 font-bold uppercase" data-id="${c.id}">Delete</button>
          </div>
        </div>
      `).join('');
    }

    // 2. Fetch Submissions
    const { data: submissions } = await supabase
      .from('submissions')
      .select('*')
      .order('created_at', { ascending: false });
      
    const subList = document.getElementById('submissions-list');
    
    if (subList && submissions) {
      subList.innerHTML = submissions.length > 0 ? submissions.map(sub => `
        <tr>
          <td class="px-6 py-4">
            <div class="flex items-center gap-3">
              ${sub.favicon_url ? `<img src="${sub.favicon_url}" class="h-6 w-6 rounded" />` : '<div class="h-6 w-6 bg-gray-100 rounded"></div>'}
              <div>
                <div class="text-sm font-bold text-black dark:text-white">${sub.title}</div>
                <div class="text-[10px] text-gray-400 font-mono">${sub.url}</div>
              </div>
            </div>
          </td>
          <td class="px-6 py-4">
            <span class="text-xs text-gray-600 dark:text-zinc-400">${sub.category}</span>
          </td>
          <td class="px-6 py-4">
            <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-bold uppercase tracking-tight ${
              sub.status === 'pending' ? 'bg-yellow-50 text-yellow-700 dark:bg-yellow-900/20 dark:text-yellow-400' : 
              sub.status === 'approved' ? 'bg-green-50 text-green-700 dark:bg-green-900/20 dark:text-green-400' : 
              'bg-red-50 text-red-700 dark:bg-red-900/20 dark:text-red-400'
            }">
              ${sub.status}
            </span>
          </td>
          <td class="px-6 py-4 text-right">
            ${sub.status === 'pending' ? `
              <div class="flex justify-end gap-3">
                <button class="approve-btn text-emerald-600 hover:text-emerald-800 text-[10px] font-bold uppercase" 
                  data-id="${sub.id}" 
                  data-title="${sub.title}" 
                  data-url="${sub.url}" 
                  data-description="${sub.description}" 
                  data-favicon="${sub.favicon_url || ''}"
                  data-category="${sub.category}">
                  Approve
                </button>
                <button class="reject-btn text-red-600 hover:text-red-800 text-[10px] font-bold uppercase" data-id="${sub.id}">
                  Reject
                </button>
              </div>
            ` : ''}
          </td>
        </tr>
      `).join('') : `
        <tr>
          <td colspan="4" class="px-6 py-12 text-center text-sm text-gray-500">
            No submissions found.
          </td>
        </tr>
      `;
    }

    // 3. Fetch Contact Messages
    const { data: contacts } = await supabase
      .from('contact_messages')
      .select('*')
      .order('created_at', { ascending: false });
      
    const contactList = document.getElementById('contacts-list');
    
    if (contactList && contacts) {
      contactList.innerHTML = contacts.length > 0 ? contacts.map(msg => `
        <tr>
          <td class="px-6 py-4">
            <div class="text-sm font-bold text-black dark:text-white">${msg.name}</div>
            <div class="text-[10px] text-gray-400 font-mono">${msg.email}</div>
          </td>
          <td class="px-6 py-4">
            <span class="text-xs text-gray-600 dark:text-zinc-400">${msg.subject || 'No Subject'}</span>
          </td>
          <td class="px-6 py-4">
            <p class="text-xs text-gray-600 dark:text-zinc-400 max-w-xs truncate" title="${msg.message}">${msg.message}</p>
          </td>
          <td class="px-6 py-4 text-right">
            <div class="flex justify-end gap-3">
              <a href="mailto:${msg.email}?subject=Re: ${msg.subject || 'Your inquiry'}" class="text-blue-600 hover:text-blue-800 text-[10px] font-bold uppercase">Reply</a>
              <button class="delete-contact-btn text-red-600 hover:text-red-800 text-[10px] font-bold uppercase" data-id="${msg.id}">Delete</button>
            </div>
          </td>
        </tr>
      `).join('') : `
        <tr>
          <td colspan="4" class="px-6 py-12 text-center text-sm text-gray-500">
            No messages found.
          </td>
        </tr>
      `;
    }

    // 4. Fetch Directory Tools
    const { data: tools } = await supabase
      .from('tools_directory')
      .select('*')
      .order('created_at', { ascending: false });
      
    allTools = tools || [];
    renderToolsList(allTools);

    attachEventListeners();
  }

  function renderToolsList(tools) {
    const toolsList = document.getElementById('tools-list');
    if (!toolsList) return;

    toolsList.innerHTML = tools.length > 0 ? tools.map(tool => `
      <tr>
        <td class="px-6 py-4">
          <div class="flex items-center gap-3">
            ${tool.favicon_url ? `<img src="${tool.favicon_url}" class="h-6 w-6 rounded" />` : '<div class="h-6 w-6 bg-gray-100 rounded"></div>'}
            <div>
              <div class="text-sm font-bold text-black dark:text-white">${tool.title}</div>
              <div class="text-[10px] text-gray-400 font-mono">${tool.url}</div>
            </div>
          </div>
        </td>
        <td class="px-6 py-4">
          <span class="text-xs text-gray-600 dark:text-zinc-400">${allCategories.find(c => c.id === tool.category_id)?.name || tool.category || 'General'}</span>
        </td>
        <td class="px-6 py-4">
          <div class="flex items-center gap-1.5 text-[10px] font-bold text-gray-500">
            <svg class="h-3 w-3 text-orange-500" fill="currentColor" viewBox="0 0 24 24"><path d="M12 21l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.18L12 21z" /></svg>
            ${tool.upvotes}
          </div>
        </td>
        <td class="px-6 py-4 text-right">
          <div class="flex justify-end gap-3">
            <button class="edit-tool-btn text-blue-600 hover:text-blue-800 text-[10px] font-bold uppercase" data-id="${tool.id}">Edit</button>
            <button class="delete-tool-btn text-red-600 hover:text-red-800 text-[10px] font-bold uppercase" data-id="${tool.id}">Delete</button>
          </div>
        </td>
      </tr>
    `).join('') : `
      <tr><td colspan="4" class="px-6 py-12 text-center text-sm text-gray-500">No tools found.</td></tr>
    `;
    
    // Attach tool actions
    document.querySelectorAll('.edit-tool-btn').forEach(btn => {
      (btn as HTMLElement).onclick = () => openEditModal((btn as HTMLElement).dataset.id);
    });
    document.querySelectorAll('.delete-tool-btn').forEach(btn => {
      (btn as HTMLElement).onclick = () => deleteTool((btn as HTMLElement).dataset.id);
    });
  }

  function attachEventListeners() {
    // Tool Search
    const searchInput = document.getElementById('tool-search') as HTMLInputElement;
    searchInput.oninput = () => {
      const q = searchInput.value.toLowerCase();
      const filtered = allTools.filter(t => 
        t.title.toLowerCase().includes(q) || 
        t.url.toLowerCase().includes(q) ||
        (t.description && t.description.toLowerCase().includes(q))
      );
      renderToolsList(filtered);
    };

    // Metadata Fetch for Direct Add
    const adminFetchBtn = document.getElementById('admin-fetch-btn') as HTMLButtonElement;
    adminFetchBtn.onclick = async () => {
      const url = (document.getElementById('admin-url') as HTMLInputElement).value;
      if (!url) return;
      adminFetchBtn.textContent = '...';
      try {
        const res = await fetch('/api/fetch-meta', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ url })
        });
        const meta = await res.json();
        if (meta.title) (document.getElementById('admin-title') as HTMLInputElement).value = meta.title;
        if (meta.description) (document.getElementById('admin-description') as HTMLTextAreaElement).value = meta.description;
        if (meta.favicon_url) (document.getElementById('admin-favicon-url') as HTMLInputElement).value = meta.favicon_url;
      } finally {
        adminFetchBtn.textContent = 'FETCH';
      }
    };

    // Add Tool Form
    const addToolForm = document.getElementById('add-tool-form') as HTMLFormElement;
    if (addToolForm) {
      addToolForm.onsubmit = async (e) => {
        e.preventDefault();
        const fd = new FormData(addToolForm);
        const { error } = await supabase.from('tools_directory').insert({
          url: fd.get('url'),
          title: fd.get('title'),
          category_id: fd.get('category_id'),
          description: fd.get('description'),
          favicon_url: fd.get('favicon_url')
        });
        if (error) alert(error.message);
        else { addToolForm.reset(); loadAdminData(); }
      };
    }

    // Add Category Form
    const addCatForm = document.getElementById('add-category-form') as HTMLFormElement;
    if (addCatForm) {
      addCatForm.onsubmit = async (e) => {
        e.preventDefault();
        const fd = new FormData(addCatForm);
        const { error } = await supabase.from('categories').insert({ name: fd.get('name') });
        if (error) alert(error.message);
        else { addCatForm.reset(); loadAdminData(); }
      };
    }

    // Update Category
    document.querySelectorAll('.update-category').forEach(btn => {
      (btn as HTMLElement).onclick = async () => {
        const id = (btn as HTMLElement).dataset.id;
        const input = document.querySelector(`.category-name-input[data-id="${id}"]`) as HTMLInputElement;
        const { error } = await supabase.from('categories').update({ name: input.value }).eq('id', id);
        if (error) alert(error.message);
        else alert('Category updated!');
      };
    });

    // Delete Category
    document.querySelectorAll('.delete-category').forEach(btn => {
       (btn as HTMLElement).onclick = async () => {
         const id = (btn as HTMLElement).dataset.id;
         if (confirm('Delete this category?')) {
           const { error } = await supabase.from('categories').delete().eq('id', id);
           if (error) alert(error.message);
           else loadAdminData();
         }
       };
    });

    // Approve Submission
    document.querySelectorAll('.approve-btn').forEach(btn => {
      (btn as HTMLElement).onclick = async () => {
        const d = (btn as HTMLElement).dataset;
        if (!confirm(`Approve "${d.title}"?`)) return;
        
        const { data: cat } = await supabase.from('categories').select('id').eq('name', d.category).is('user_id', null).single();
        
        const { error: insErr } = await supabase.from('tools_directory').insert({
          url: d.url,
          title: d.title,
          description: d.description,
          category: d.category,
          category_id: cat?.id || null,
          favicon_url: d.favicon
        });

        if (insErr) { alert(insErr.message); return; }

        await supabase.from('submissions').update({ status: 'approved' }).eq('id', d.id);
        loadAdminData();
      };
    });

    // Reject Submission
    document.querySelectorAll('.reject-btn').forEach(btn => {
      (btn as HTMLElement).onclick = async () => {
        const id = (btn as HTMLElement).dataset.id;
        if (confirm('Reject?')) {
          await supabase.from('submissions').update({ status: 'rejected' }).eq('id', id);
          loadAdminData();
        }
      };
    });

    // Delete Contact Message
    document.querySelectorAll('.delete-contact-btn').forEach(btn => {
      (btn as HTMLElement).onclick = async () => {
        const id = (btn as HTMLElement).dataset.id;
        if (confirm('Delete this message?')) {
          const { error } = await supabase.from('contact_messages').delete().eq('id', id);
          if (error) alert(error.message);
          else loadAdminData();
        }
      };
    });
  }

  const editModal = document.getElementById('edit-tool-modal');
  const editForm = document.getElementById('edit-tool-form') as HTMLFormElement;

  function openEditModal(id) {
    const tool = allTools.find(t => t.id === id);
    if (!tool) return;

    (document.getElementById('edit-id') as HTMLInputElement).value = tool.id;
    (document.getElementById('edit-url') as HTMLInputElement).value = tool.url;
    (document.getElementById('edit-title') as HTMLInputElement).value = tool.title;
    (document.getElementById('edit-favicon') as HTMLInputElement).value = tool.favicon_url || '';
    (document.getElementById('edit-description') as HTMLTextAreaElement).value = tool.description || '';
    (document.getElementById('edit-category-select') as HTMLSelectElement).value = tool.category_id || '';

    editModal?.classList.remove('hidden');
  }

  document.getElementById('close-edit-modal').onclick = () => editModal?.classList.add('hidden');

  editForm.onsubmit = async (e) => {
    e.preventDefault();
    const fd = new FormData(editForm);
    const id = fd.get('id');
    const { error } = await supabase.from('tools_directory').update({
      url: fd.get('url'),
      title: fd.get('title'),
      favicon_url: fd.get('favicon_url'),
      description: fd.get('description'),
      category_id: fd.get('category_id')
    }).eq('id', id);

    if (error) alert(error.message);
    else {
      editModal?.classList.add('hidden');
      loadAdminData();
    }
  };

  async function deleteTool(id) {
    if (confirm('Permanently delete this tool?')) {
      const { error } = await supabase.from('tools_directory').delete().eq('id', id);
      if (error) alert(error.message);
      else loadAdminData();
    }
  }

  checkAdmin();
</script>
