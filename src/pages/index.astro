---
import Layout from '../layouts/Layout.astro';
import FAQ from '../components/FAQ.astro';
---

<Layout>
	<!-- Hero Section -->
	<section class="relative overflow-hidden pt-20 pb-32 sm:pt-32 sm:pb-40">
		<!-- Mesh Gradient Background -->
		<div class="absolute top-0 left-1/2 -z-10 h-[1000px] w-[1000px] -translate-x-1/2 [mask-image:radial-gradient(closest-side,white,transparent)] sm:-top-80">
			<div class="absolute inset-0 bg-gradient-to-r from-cyan-400 via-blue-500 to-magenta-500 opacity-20 blur-3xl"></div>
			<div class="absolute top-1/4 right-1/4 h-64 w-64 bg-amber-400 opacity-20 blur-3xl"></div>
		</div>

		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
			<h1 class="text-4xl font-extrabold tracking-tight text-black dark:text-white sm:text-7xl">
				All your websites and links <br />
				<span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-cyan-500">in one place.</span>
			</h1>
			<p class="mt-6 mx-auto max-w-2xl text-lg text-gray-600 dark:text-zinc-400 sm:text-xl">
				Stop losing links and keeping endless tabs open. Save, organize, and access all your favorite websites. <br class="hidden sm:block" />
				<span class="font-semibold text-black dark:text-white">100% Free. Unlimited links. No restrictions.</span>
			</p>
			<div class="mt-10 flex flex-wrap items-center justify-center gap-4">
				<a href="/my-tools" class="rounded-full bg-black dark:bg-white px-8 py-3 text-sm font-semibold text-white dark:text-black shadow-sm hover:bg-gray-800 dark:hover:bg-zinc-200 transition-all transform hover:scale-105">
					Go to My Workspace
				</a>
				<a href="/directory" class="rounded-full bg-white dark:bg-zinc-900 border border-gray-200 dark:border-zinc-800 px-8 py-3 text-sm font-semibold text-gray-900 dark:text-zinc-100 shadow-sm hover:bg-gray-50 dark:hover:bg-zinc-800 transition-all">
					Explore Hidden Gems
				</a>
			</div>
		</div>
	</section>

	<!-- Features Grid -->
	<section class="py-24 bg-gray-50/50 dark:bg-zinc-900/50">
		<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
			<div class="grid grid-cols-1 gap-12 sm:grid-cols-3">
				<div class="space-y-4">
					<div class="h-10 w-10 rounded-lg bg-blue-600 flex items-center justify-center">
						<svg class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
						</svg>
					</div>
					<h3 class="text-xl font-bold text-black dark:text-white">Unlimited Link Storage</h3>
					<p class="text-gray-600 dark:text-zinc-400">Add as many websites as you want for free. Keep everything organized so you never lose a link again.</p>
				</div>
				<div class="space-y-4">
					<div class="h-10 w-10 rounded-lg bg-black dark:bg-white flex items-center justify-center">
						<svg class="h-6 w-6 text-white dark:text-black" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
						</svg>
					</div>
					<h3 class="text-xl font-bold text-black dark:text-white">Guest Mode</h3>
					<p class="text-gray-600 dark:text-zinc-400">Start using it instantly. Your data is saved locally and syncs to your account when you sign up.</p>
				</div>
				<div class="space-y-4">
					<div class="h-10 w-10 rounded-lg bg-cyan-500 flex items-center justify-center">
						<svg class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
						</svg>
					</div>
					<h3 class="text-xl font-bold text-black dark:text-white">Hidden Gems</h3>
					<p class="text-gray-600 dark:text-zinc-400">Discover the best tools, libraries, and resources curated by the community. Upvote your favorites.</p>
				</div>
			</div>
		</div>
	</section>

	<FAQ />
</Layout>
