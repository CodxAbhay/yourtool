---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';

interface Props {
	title?: string;
	description?: string;
}

const { 
	title = "yourtool.in | Professional Link Management & Curated Tools",
	description = "Your personal workspace for saving daily links and a public directory of hidden gems."
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark:bg-zinc-950 dark:text-zinc-100">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-GCLSK63NX2" is:inline></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());

			gtag('config', 'G-GCLSK63NX2');
		</script>
		<script is:inline>
			const theme = (() => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
					return 'dark';
				}
				return 'light';
			})();
		
			if (theme === 'light') {
				document.documentElement.classList.remove('dark');
			} else {
				document.documentElement.classList.add('dark');
			}
			window.localStorage.setItem('theme', theme);
		</script>
	</head>
	<body class="min-h-screen bg-white dark:bg-zinc-950 font-sans antialiased text-gray-900 dark:text-zinc-100 transition-colors duration-300">
		<Navbar />
		<main>
			<slot />
		</main>
		<footer class="border-t border-gray-100 dark:border-zinc-800 py-12 bg-gray-50 dark:bg-zinc-900/50">
			<div class="max-w-7xl mx-auto px-4">
				<div class="flex flex-col md:flex-row justify-between items-center gap-8">
					<div class="text-sm text-gray-500">
						&copy; {new Date().getFullYear()} yourtool.in. All rights reserved.
					</div>
					<div class="flex flex-wrap justify-center gap-6">
						<a href="/about-us" class="text-sm text-gray-500 hover:text-black dark:hover:text-white transition-colors">About Us</a>
						<a href="/how-to-use" class="text-sm text-gray-500 hover:text-black dark:hover:text-white transition-colors">How To Use</a>
						<a href="/contact-us" class="text-sm text-gray-500 hover:text-black dark:hover:text-white transition-colors">Contact Us</a>
						<a href="/privacy-policy" class="text-sm text-gray-500 hover:text-black dark:hover:text-white transition-colors">Privacy Policy</a>
						<a href="/terms-and-conditions" class="text-sm text-gray-500 hover:text-black dark:hover:text-white transition-colors">Terms & Conditions</a>
					</div>
				</div>
			</div>
		</footer>
	</body>
</html>
